#!/bin/sh
# Нарезка готового ролика на части — двойным кликом, без терминала.
#
# Спросит ролик (его можно просто перетащить в окно) и секунды реза.
# Обложку и подпись «Часть N» берёт на себя нарезать.sh из этой же папки.
cd "$(dirname "$0")" || exit 1
[ -f "./нарезать.sh" ] || {
  echo "Рядом нет нарезать.sh — распакуйте папку целиком."
  echo "Enter — закрыть."; read -r _; exit 1; }

echo "═══ Нарезка ролика на части ═══"
echo
echo "1. Перетащите сюда ГОТОВЫЙ ролик (тот, что сделал собрать.sh) и нажмите Enter:"
printf "   > "
read -r V
# Перетаскивание в Терминал даёт путь либо в кавычках, либо с экранированными
# пробелами («/Users/andre/Мой ролик.mp4» → «/Users/andre/Мой\ ролик.mp4»).
# Снимаем и то, и другое, иначе файл «не найден» при том, что он на месте.
V=$(printf "%s" "$V" | sed "s/^[\"']//; s/[\"']$//; s/\\\\ / /g")
[ -f "$V" ] || { echo "Не найден файл: $V"; echo "Enter — закрыть."; read -r _; exit 1; }

echo
echo "2. На каких секундах резать? Через пробел, можно мм:сс."
echo "   Два числа → три части, три числа → четыре части."
printf "   > "
read -r CUTS
[ -n "$CUTS" ] || { echo "Числа не введены."; echo "Enter — закрыть."; read -r _; exit 1; }

echo
sh "./нарезать.sh" "$V" $CUTS
echo
echo "Enter — закрыть окно."
read -r _
